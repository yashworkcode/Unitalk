# Copy this file to .env and fill in real values before running the server.

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma separated list of origins allowed to call the API / connect the socket.
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# Local Mongo:      mongodb://127.0.0.1:27017/unitalk
# MongoDB Atlas:    mongodb+srv://<user>:<password>@<cluster>/unitalk
MONGODB_URI=mongodb+srv://yashworkcode:20006yasH@mytunes.i6a8s5p.mongodb.net/?appName=mytunes

# --- Auth ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Password reset emails ---
# If left blank, reset links are printed to the server console instead of emailed
# (handy for local development). Fill these in to actually send email via SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="UniTalk <no-reply@unitalk.app>"
# Base URL of the deployed frontend, used to build the password reset link.
APP_URL=http://localhost:5173

# --- Translation ---
# "google-cloud" = official Google Cloud Translation API. USE THIS FOR A LIVE/
#   PRODUCTION SITE (e.g. hosted on Render). Free tier: 500,000 chars/month.
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project (or use an existing one) and enable "Cloud Translation API"
#      at https://console.cloud.google.com/apis/library/translate.googleapis.com
#   3. Create an API key on the credentials page and paste it below.
#   4. (Recommended) Restrict the key to only the Cloud Translation API.
# "google-free" = the public translate.googleapis.com trick endpoint. No key needed,
#   fine for local testing, but unofficial - no SLA, can break or rate-limit anytime.
#   Do not rely on this for a live site.
# "libretranslate" = a self-hosted or public LibreTranslate instance.
# "none" = no network calls at all, uses only the small bundled phrase dictionary.
TRANSLATION_PROVIDER=google-free
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=
